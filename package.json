{
  "name": "salient",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A turn-based tactics game: capture command posts, buy units, fight through fog of war.",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p .",
    "test": "tsx scripts/test-rules.ts",
    "test:flow": "tsx scripts/test-flow.ts",
    "audit:mobile": "tsx scripts/audit-mobile.ts",
    "shot": "tsx scripts/shot.ts",
    "test:all": "npm run typecheck && npm test && npm run test:flow && npm run test:editor && npm run test:keys && npm run audit:mobile && npm run shot",
    "seed": "tsx scripts/seed.ts",
    "unseed": "tsx scripts/unseed.ts",
    "set-password": "tsx scripts/set-password.ts",
    "unlock": "tsx scripts/unlock.ts",
    "backup": "tsx scripts/backup-db.ts",
    "db:generate": "drizzle-kit generate",
    "test:editor": "tsx scripts/test-editor.ts",
    "test:keys": "tsx scripts/test-keys.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
