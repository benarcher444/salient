# Copy to .env and adjust:   cp env.example .env
# Every value has a default, so the app also runs with no .env at all.

# Port and interface to listen on. On the server HOST must stay 127.0.0.1 so
# Caddy is the only way in; use 0.0.0.0 at home to reach it from a phone.
PORT=3000
HOST=127.0.0.1

# production builds the browser bundle once at boot and turns down logging.
# NODE_ENV=production

# Where the SQLite database lives. Defaults to data/app.db.
# DATABASE_PATH=/opt/salient/data/app.db

# The invite list: one email per line. Missing file = nobody can sign up.
# INVITES_PATH=/opt/salient/invites.txt
